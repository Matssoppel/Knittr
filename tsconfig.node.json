{
  "compilerOptions": {
    "composite": true,
    // `tsc -b` must emit for composite projects; keep that output out of the
    // project root, where a stray vite.config.js would override vite.config.ts.
    "outDir": "./node_modules/.tmp/tsconfig-node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true
  },
  "include": ["vite.config.ts"]
}
